# Copy to server/.env.local — never commit real values.
# Console login
ADMIN_PASSWORD=
# Long random string; keeps sessions and signed image links valid across restarts
SESSION_SECRET=
# Key used to verify webhook X-Signature. Production: the HMAC Signing Key issued by Ring.
# Hackathon: our own dev key, shared with the labelled simulator.
RING_HMAC_KEY=
# Optional: Ring Developer Playground access token (~30 min). Can also be pasted in the console.
RING_ACCESS_TOKEN=
# live | replay (replay = recorded real Playground responses, public judge sandbox)
DOORSIGNAL_MODE=live
# Hours an alert image is kept (minutes)
IMAGE_TTL_MIN=60
