# Copy to server/.env.local — never commit real values.
# Console login
ADMIN_PASSWORD=
# Long random string; keeps sessions and signed image links valid across restarts
SESSION_SECRET=
# Key used to verify webhook X-Signature. Production: the HMAC Signing Key issued by Ring.
# Hackathon: our own dev key, shared with the labelled simulator.
RING_HMAC_KEY=
# Set to "ring" ONLY when RING_HMAC_KEY is the signing key issued by Ring; otherwise every
# webhook event is labelled SIMULATED in the UI.
RING_HMAC_KEY_SOURCE=
# Optional: Ring Developer Playground access token (~30 min). Can also be pasted in the console.
RING_ACCESS_TOKEN=
# live | replay (replay = recorded real Playground responses, public judge sandbox)
DOORSIGNAL_MODE=live
# Hours an alert image is kept (minutes)
IMAGE_TTL_MIN=60
# Amazon Bedrock image descriptions (docs/aws-bedrock.md). Off unless "on".
BEDROCK_DESCRIPTIONS=
# A Bedrock API key, or use AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY allowed to invoke Bedrock models
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
# Optional; default anthropic.claude-opus-5-5
BEDROCK_MODEL=
